<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="36dp">

        <!-- Top Sci-Fi Telemetry & Clock Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.15"
                    android:text="SAMRAT CORE"
                    android:textColor="@color/neon_cyan"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="// QUANTUM HUD PROTOCOL"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Holographic Digital Clock & Date -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHudClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cyber_panel_bg"
                    android:letterSpacing="0.1"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="18:45:22"
                    android:textColor="@color/neon_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="SYS_ENC: AES-256 // ONLINE"
                    android:textColor="@color/glow_green"
                    android:textSize="9sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Center Holographic 3D Quantum Core Display -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:layout_marginTop="16dp">

            <com.samrat.aiassistant.ui.HolographicCoreView
                android:id="@+id/holographicCore"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Core Status HUD Readout at Bottom of Sphere -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSystemStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="SYSTEM STATE: STANDBY"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVoiceModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEURAL MODEL: GEMINI MULTIMODAL LIVE"
                    android:textColor="@color/neon_purple"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Section 1: Neural Matrix Configuration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/cyber_panel_bg"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="[ NEURAL CORE CONFIGURATION ]"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Gemini API Key -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="#101520"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="@color/neon_cyan">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Gemini API Key"
                    android:inputType="textPassword"
                    android:textColor="@color/neon_cyan"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Assistant Codename -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="#101520"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="@color/neon_purple">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAssistantName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Assistant Designation (Default: JARVIS)"
                    android:text="JARVIS"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Custom Behavior / Neural Persona -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="#101520"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="@color/neon_cyan">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAssistantBehavior"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Behavioral Neural Matrix (ব্যক্তিত্ব / আচরণ)"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Section 2: Subsystems & Sentinel Security -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/cyber_panel_bg"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="[ SUBSYSTEMS &amp; SENTINEL ACCESS ]"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="2"
                android:rowCount="2">

                <!-- 1. Floating 3D Bubble -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlayPermission"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/cyber_button_cyan"
                    android:text="1. 3D BUBBLE"
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp"
                    app:backgroundTint="@null" />

                <!-- 2. Touch & Swipe Automation -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccessibilityPermission"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/cyber_button_cyan"
                    android:text="2. GESTURE AUTO"
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp"
                    app:backgroundTint="@null" />

                <!-- 3. Device Admin -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeviceAdmin"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/cyber_button_purple"
                    android:text="3. ADMIN GUARD"
                    android:textColor="@color/neon_purple"
                    android:textSize="11sp"
                    app:backgroundTint="@null" />

                <!-- 4. Notifications -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNotificationPermission"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/cyber_button_purple"
                    android:text="4. NOTIFY RADAR"
                    android:textColor="@color/neon_purple"
                    android:textSize="11sp"
                    app:backgroundTint="@null" />
            </GridLayout>
        </LinearLayout>

        <!-- Main Arc Reactor Ignition Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleAssistant"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:background="@drawable/cyber_button_cyan"
                android:letterSpacing="0.12"
                android:text="INITIALIZE SAMRAT AI"
                android:textColor="@color/neon_cyan"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </FrameLayout>

    </LinearLayout>
</ScrollView>
